// src/launch.nx — abre a janela do editor. Primeiro a extensao noxy_webview
// (janela nativa); se ela falhar em runtime — sem WebKitGTK na maquina,
// processo que nao sobe ou morre — um navegador em modo app, e por ultimo o
// navegador padrao (src/browser). No fallback a URL com o token vai numa
// pagina de redirecionamento privada, nunca na linha de comando. mode
// guarda o que deu certo.
use sys
use errors select *
use src.browser as browser
use github_com.estevaofon.noxy_webview.noxy_webview as webview

let mode: string = ""       // "webview", "app", "browser" ou ""
let redirect: string = ""   // a pagina de redirecionamento do fallback

// open_window tenta a extensao e cai para o navegador; devolve o modo.
func open_window(url: string) -> string
    let r = call_result(webview.open, "Noxy Editor", 1200, 800, url)
    if r.ok then
        mode = "webview"
        return mode
    end
    eprint("janela pela extensao indisponivel: " + r.failure.message + "; abrindo no navegador")
    let target: string = url
    redirect = browser.write_redirect(url)
    if redirect != "" then
        target = browser.file_url(redirect)
    else
        eprint("nao consegui criar a pagina de redirecionamento; a URL vai na linha de comando")
    end
    mode = browser.open_app(target)
    return mode
end

// wait_window bloqueia ate a janela da extensao fechar; nos outros modos
// volta na hora.
func wait_window() -> void
    if mode == "webview" then
        let r = call_result(webview.wait)
        if !r.ok then
            eprint("janela: " + r.failure.message)
        end
    end
end

func set_title(title: string) -> void
    if mode == "webview" then
        call_result(webview.set_title, title)
    end
end

func close_window() -> void
    if mode == "webview" then
        call_result(webview.close)
    end
    browser.cleanup(redirect)
    redirect = ""
end

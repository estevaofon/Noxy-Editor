// src/browser.nx — abre uma URL num navegador em modo app (janela sem barra
// de endereco) ou no navegador padrao. O token do editor nao pode ir na
// linha de comando (ps e /proc mostram os argumentos a qualquer usuario da
// maquina), entao write_redirect grava uma pagina de redirecionamento num
// diretorio temporario so do usuario (platform.make_temp_dir: mktemp -d com
// 0700, ou o TEMP do usuario no Windows) e o lancador passa o caminho dela
// em vez da URL.
use sys
use io
use strings select starts_with, codes, substring
use src.platform as platform

let BROWSERS: string[] = ["google-chrome", "chromium", "chromium-browser", "brave-browser", "microsoft-edge"]
// no Windows o `start` acha estes pelo registro (App Paths), mesmo fora do PATH
let WINDOWS_BROWSERS: string[] = ["chrome", "msedge", "brave"]

func has_command(name: string) -> bool
    if platform.windows() then
        return sys.exec("where " + name + " >nul 2>nul").exit_code == 0
    end
    return sys.exec("command -v " + name + " >/dev/null 2>&1").exit_code == 0
end

// dir_of e o diretorio de um caminho; "." quando nao ha barra.
func dir_of(path: string) -> string
    let cs: int[] = codes(path)
    let last: int = -1
    for i in range(length(cs)) do
        if cs[i] == 47 then
            last = i
        end
    end
    if last < 0 then
        return "."
    end
    if last == 0 then
        return "/"
    end
    return substring(path, 0, last)
end

// file_url monta a URL file:// de um caminho absoluto; "C:/x" ganha a barra
// que o Windows nao tem ("file:///C:/x").
func file_url(path: string) -> string
    if starts_with(path, "/") then
        return "file://" + path
    end
    return "file:///" + path
end

// write_redirect grava a pagina que leva a url e devolve o caminho dela;
// "" se nao conseguiu criar o diretorio ou o arquivo.
func write_redirect(url: string) -> string
    let dir: string = platform.make_temp_dir()
    if dir == "" then
        return ""
    end
    let path: string = dir + "/noxy-editor.html"
    let f: io.File = io.open(path, "w")
    if !f.open then
        return ""
    end
    io.write(f, "<!doctype html>\n<meta charset=\"utf-8\">\n<meta http-equiv=\"refresh\" content=\"0;url=" + url + "\">\n<title>Noxy Editor</title>\n")
    io.close(f)
    return path
end

// cleanup remove a pagina de redirecionamento e o diretorio dela.
func cleanup(path: string) -> void
    if path == "" then
        return
    end
    io.remove(path)
    io.remove(dir_of(path))     // o diretorio, ja vazio
end

// open_app_windows: `start "" programa args` abre chrome, msedge ou brave
// pelo registro (App Paths), e devolve 1 quando o programa nao existe; por
// fim o navegador padrao. O `""` e o titulo vazio que o start exige antes
// do programa.
func open_app_windows(target: string) -> string
    for b in WINDOWS_BROWSERS do
        if sys.exec("start \"\" " + b + " \"--app=" + target + "\" >nul 2>nul").exit_code == 0 then
            return "app"
        end
    end
    if sys.exec("start \"\" \"" + target + "\" >nul 2>nul").exit_code == 0 then
        return "browser"
    end
    return ""
end

// open_app abre target (uma URL ou file://...) e devolve "app" (janela sem
// barra), "browser" ou "".
func open_app(target: string) -> string
    if platform.windows() then
        return open_app_windows(target)
    end
    let q: string = platform.shell_quote(target)
    for b in BROWSERS do
        if has_command(b) then
            sys.exec(b + " --app=" + q + " >/dev/null 2>&1 &")
            return "app"
        end
    end
    if sys.os() == "darwin" then
        sys.exec("open " + q)
        return "browser"
    end
    if has_command("xdg-open") then
        sys.exec("xdg-open " + q + " >/dev/null 2>&1 &")
        return "browser"
    end
    return ""
end

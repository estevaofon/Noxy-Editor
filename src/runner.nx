// src/runner.nx — roda um arquivo .nx em segundo plano pelo modulo process
// da stdlib: a saida chega aos pedacos a cada poll, sem bloquear, e Parar
// alcanca o programa e o que ele abriu (grupo de processos no Linux e
// macOS, job no Windows). O programa roda com a raiz como cwd e a entrada
// no dispositivo nulo. Quando ele sai, o que deixou rodando morre junto
// (process.close); quando o editor sai, o Noxy mata o que ainda roda.
use sys
use process
use strings select ends_with, is_valid_utf8
use src.platform as platform

let KILL_AFTER_MS = 2000

struct RunState
    running: bool
    text: string       // o conteudo do painel de saida
    version: int       // muda a cada alteracao de text ou running
    cmd: string        // o comando do programa
    proc: process.Process
    stopping: bool
    stop_at: int
end

func new_run() -> RunState
    return RunState(false, "", 0, "", process.Process(-1, -1, false, ""), false, 0)
end

// noxy_exe: o interpretador que roda este editor — o noxy, ou o proprio
// noxy-editor gerado por `noxy build` (docs/BUILD.md do noxy). "" (o
// sistema nao soube dizer) cai no `noxy` do PATH.
func noxy_exe() -> string
    let exe: string = sys.executable()
    if exe == "" then
        return "noxy"
    end
    return exe
end

// command e o que roda: cd na raiz e o interpretador no arquivo, na sintaxe
// do shell da plataforma, com NOXY_INTERPRETER=1 SO no ambiente do filho
// (`VAR=1 exec` no sh; `set` dentro do cmd no Windows) — num noxy-editor
// autocontido a variavel faz o binario rodar como noxy comum, e ela e
// herdada, entao nunca vai no ambiente do editor. No Windows o process roda
// `cmd /S /C "<linha>"`, que entrega as aspas da linha intactas.
func command(root: string, rel: string) -> string
    if platform.windows() then
        return "cd /D \"" + platform.backslashes(root) + "\" && set NOXY_INTERPRETER=1&& \"" + platform.backslashes(noxy_exe()) + "\" \"" + platform.backslashes(rel) + "\""
    end
    return "cd " + platform.shell_quote(root) + " && NOXY_INTERPRETER=1 exec " + platform.shell_quote(noxy_exe()) + " " + platform.shell_quote(rel)
end

// start dispara a execucao; devolve "" ou a mensagem de recusa.
func start(r: ref RunState, root: string, rel: string) -> string
    if r.running then
        return "ja esta rodando"
    end
    r.cmd = command(root, rel)
    let p: process.Process = process.start(r.cmd)
    if !p.ok then
        return "nao consegui iniciar o programa: " + p.error
    end
    r.proc = p
    r.stopping = false
    r.text = "$ noxy " + rel + "\n"
    r.running = true
    r.version = r.version + 1
    return ""
end

// read_new anexa o que o programa escreveu desde a ultima leitura. O
// process nunca parte um caractere UTF-8 entre leituras, entao um pedaco
// invalido e saida que nao e texto.
func read_new(r: ref RunState) -> void
    let got: bytes = process.read(r.proc)
    if length(got) == 0 then
        return
    end
    if is_valid_utf8(got) then
        r.text = r.text + to_str(got)
    else
        r.text = r.text + "[saida que nao e UTF-8 omitida]\n"
    end
    r.version = r.version + 1
end

func finish(r: ref RunState, tail: string) -> void
    read_new(r)
    if !ends_with(r.text, "\n") then
        r.text = r.text + "\n"
    end
    r.text = r.text + tail
    process.close(r.proc)
    r.running = false
    r.stopping = false
    r.version = r.version + 1
end

// poll recolhe a saida nova e o fim; chamado a cada evento.
func poll(r: ref RunState, now: int) -> void
    if !r.running then
        return
    end
    read_new(r)
    let st: process.ProcessStatus = process.poll(r.proc)
    if r.stopping then
        if !st.running then
            finish(r, "[interrompido]")
        elif now - r.stop_at >= KILL_AFTER_MS then
            process.kill(r.proc)
        end
        return
    end
    if !st.running then
        finish(r, "[saiu com " + to_str(st.exit_code) + "]")
    end
end

// stop pede a parada da arvore (TERM no Unix; no Windows o job termina na
// hora); poll mata com KILL se nao sair em KILL_AFTER_MS.
func stop(r: ref RunState, now: int) -> string
    if !r.running then
        return "nada rodando"
    end
    process.terminate(r.proc)
    r.stopping = true
    r.stop_at = now
    r.version = r.version + 1
    return ""
end
